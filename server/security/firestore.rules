rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      // Profile reads go through Express so a valid Firebase token alone cannot
      // bypass an expired application session, even for the user's own profile.
      allow read: if false;
      // Preserve existing email/password onboarding. Roles and account updates
      // are managed only by the authenticated Express admin endpoints.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'role', 'status', 'createdAt', 'created_at'])
        && request.resource.data.uid == userId
        && request.resource.data.role == 'law_student'
        && request.resource.data.status == 'active'
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string;
      allow update, delete: if false;
    }
    // All case, assignment, document, AI context and workspace operations use
    // Express, which verifies live roles and relationships through Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
